{
  "name": "legendai-desktop",
  "version": "2.1.5",
  "description": "LegendAI — sincronização local de roteiros e narrações.",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:engine": "pyinstaller --noconfirm --clean LegendAIEngine.spec",
    "pack:win": "npm run build && electron-builder --win nsis --publish never",
    "release:github": "npm run build && electron-builder --win nsis --publish always",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  },
  "build": {
    "appId": "com.faah.legendai",
    "productName": "LegendAI",
    "afterPack": "./scripts/after-pack.js",
    "directories": {
      "output": "release-electron"
    },
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/LegendAIEngine",
        "to": "engine"
      },
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/legendai.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "faahpla",
        "repo": "LegendAI",
        "releaseType": "release"
      }
    ]
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true
  }
}
